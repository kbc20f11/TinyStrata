# Keep the repository limited to build/runtime sources and project metadata.
/*
!/.gitattributes
!/.gitignore
!/CMakeLists.txt
!/LICENSE
!/NOTICE
!/README.md
!/README.zh-CN.md
!/README.ja.md
!/README.de.md
!/README.fr.md
!/README.es.md
!/README.pt-BR.md
!/requirements.txt
!/install.ps1
!/install-ui.ps1
!/run-api.bat
!/run-ui.bat
!/run.py
!/assets/
!/benchmark/
!/cmake/
!/include/
!/serve/
!/src/
!/third_party/
!/ui/
!/tests/

# Keep only the public installer regression test, not local test artifacts.
/tests/**
!/tests/installer-entrypoints.ps1

# Only build/runtime sources and the fixed public benchmark inputs belong here.
/benchmark/**
!/benchmark/README.md
!/benchmark/run.py
!/benchmark/cases.json
!/benchmark/image.png
!/benchmark/results/
/benchmark/results/**
!/benchmark/results/*.md
/assets/**
!/assets/memory-sharing.png
!/assets/automatic-settings.png
/cmake/**
!/cmake/**/
!/cmake/**/*.cmake
/include/**
!/include/**/
!/include/**/*.h
!/include/**/*.hpp
!/include/**/*.cuh
!/include/**/*.inl
/serve/**
!/serve/**/
!/serve/**/*.py
!/serve/**/*.jinja
/src/**
!/src/**/
!/src/**/*.c
!/src/**/*.cpp
!/src/**/*.cu
!/src/**/*.cuh
!/src/**/*.h
!/src/**/*.hpp
!/src/**/*.inl
/third_party/**
!/third_party/ggml/
!/third_party/ggml/LICENSE
!/third_party/ggml/VERSION.txt
!/third_party/ggml/ggml-common.h
!/third_party/licenses/
!/third_party/licenses/*.txt
/ui/**
!/ui/server.py
!/ui/launch.py
!/ui/web/
!/ui/web/*.html
!/ui/web/*.css
!/ui/web/*.js
!/ui/web/*.svg
!/ui/web/fonts/
!/ui/web/fonts/OFL.txt
!/ui/web/fonts/*.woff2
!/ui/web/locales/
!/ui/web/locales/en.json
!/ui/web/locales/zh-CN.json
!/ui/web/locales/ja.json
!/ui/web/locales/de.json
!/ui/web/locales/fr.json
!/ui/web/locales/es.json
!/ui/web/locales/pt-BR.json
!/ui/web/vendor/
!/ui/web/vendor/katex/
!/ui/web/vendor/katex/LICENSE
!/ui/web/vendor/katex/PROVENANCE.json
!/ui/web/vendor/katex/dist/
!/ui/web/vendor/katex/dist/*.css
!/ui/web/vendor/katex/dist/*.js
!/ui/web/vendor/katex/dist/fonts/
!/ui/web/vendor/katex/dist/fonts/*.woff2

# Local environments, generated artifacts and development-only files.
/serve/test_*.py
