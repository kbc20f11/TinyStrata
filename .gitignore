# Keep the repository limited to build/runtime sources and project metadata.
/*
!/.gitattributes
!/.gitignore
!/CMakeLists.txt
!/LICENSE
!/NOTICE
!/README.md
!/requirements.txt
!/install.ps1
!/run-api.bat
!/run.py
!/assets/
!/cmake/
!/include/
!/serve/
!/src/
!/third_party/

# Only build/runtime source types belong inside the permitted directories.
/assets/**
!/assets/memory-sharing.png
!/assets/automatic-settings.png
/cmake/**
!/cmake/**/
!/cmake/**/*.cmake
/include/**
!/include/**/
!/include/**/*.h
!/include/**/*.hpp
!/include/**/*.cuh
!/include/**/*.inl
/serve/**
!/serve/**/
!/serve/**/*.py
!/serve/**/*.jinja
/src/**
!/src/**/
!/src/**/*.c
!/src/**/*.cpp
!/src/**/*.cu
!/src/**/*.cuh
!/src/**/*.h
!/src/**/*.hpp
!/src/**/*.inl
/third_party/**
!/third_party/ggml/
!/third_party/ggml/LICENSE
!/third_party/ggml/VERSION.txt
!/third_party/ggml/ggml-common.h
!/third_party/licenses/
!/third_party/licenses/*.txt

# Local environments, generated artifacts and development-only files.
/serve/test_*.py
/serve/**/test_*.py
