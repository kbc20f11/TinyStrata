# Keep the pinned dependency untouched. Compile generated copies with private
# adapters for releasing image workspaces while retaining the GPU model.
function(tinystrata_vision_workspace)
  set(_directory "${CMAKE_BINARY_DIR}/tinystrata-vision")
  file(MAKE_DIRECTORY "${_directory}")
  foreach(_unit clip mtmd)
    set(_original "${STRATA_LLAMA_SOURCE_DIR}/tools/mtmd/${_unit}.cpp")
    set(_body "${PROJECT_SOURCE_DIR}/src/vision/${_unit}_workspace.inl")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_original}" "${_body}")
    file(READ "${_original}" _code)
    file(READ "${_body}" _extension)
    if(_unit STREQUAL "clip")
      set(_members "    int max_nodes = 8192;")
      set(_callback "        if (ctx_params.cb_eval != nullptr) {")
      string(FIND "${_code}" "${_members}" _has_members)
      string(FIND "${_code}" "${_callback}" _has_callback)
      if(_has_members LESS 0 OR _has_callback LESS 0)
        message(FATAL_ERROR "The pinned mtmd scheduler changed; review the TinyStrata workspace adapter")
      endif()
      string(REPLACE "${_members}"
        "    ggml_backend_sched_eval_callback tinystrata_cb_eval = nullptr;\n    void * tinystrata_cb_eval_user_data = nullptr;\n${_members}" _code "${_code}")
      string(REPLACE "${_callback}"
        "        tinystrata_cb_eval = ctx_params.cb_eval;\n        tinystrata_cb_eval_user_data = ctx_params.cb_eval_user_data;\n${_callback}" _code "${_code}")
    endif()
    file(WRITE "${_directory}/${_unit}.cpp.in" "${_code}\n${_extension}\n")
    configure_file("${_directory}/${_unit}.cpp.in" "${_directory}/${_unit}.cpp" COPYONLY)
  endforeach()

  get_target_property(_sources mtmd SOURCES)
  get_target_property(_source_dir mtmd SOURCE_DIR)
  set(_adapted)
  foreach(_source IN LISTS _sources)
    if(_source STREQUAL "clip.cpp" OR _source STREQUAL "${STRATA_LLAMA_SOURCE_DIR}/tools/mtmd/clip.cpp")
      list(APPEND _adapted "${_directory}/clip.cpp")
    elseif(_source STREQUAL "mtmd.cpp" OR _source STREQUAL "${STRATA_LLAMA_SOURCE_DIR}/tools/mtmd/mtmd.cpp")
      list(APPEND _adapted "${_directory}/mtmd.cpp")
    elseif(IS_ABSOLUTE "${_source}" OR _source MATCHES "^\\$<")
      list(APPEND _adapted "${_source}")
    else()
      list(APPEND _adapted "${_source_dir}/${_source}")
    endif()
  endforeach()
  set_property(TARGET mtmd PROPERTY SOURCES "${_adapted}")
endfunction()
