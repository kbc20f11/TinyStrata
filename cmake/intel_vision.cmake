# GPU image encoder for native Windows Intel. Keep llama.cpp/MTMD at the
# existing TinyStrata vision pin and build its SYCL backend in the same ABI.
function(tinystrata_add_intel_vision_encoder)
  set(STRATA_GGML_DIR "" CACHE PATH "Existing pinned llama.cpp checkout for the Intel image encoder")
  if(STRATA_GGML_DIR)
    set(_vision_llama "${STRATA_GGML_DIR}")
  else()
    include(FetchContent)
    FetchContent_Declare(tinystrata_intel_vision_llama
      URL https://codeload.github.com/ggml-org/llama.cpp/tar.gz/3cf03257f219afbe7334045ff7c6a06ac68c627d
      URL_HASH SHA256=c076d7534afa0e5d0ec2a0d425b11e791c16f3de0d727221aea071cef156a280
      SOURCE_DIR "${CMAKE_BINARY_DIR}/vision-deps/llama")
    FetchContent_GetProperties(tinystrata_intel_vision_llama)
    if(NOT tinystrata_intel_vision_llama_POPULATED)
      FetchContent_Populate(tinystrata_intel_vision_llama)
    endif()
    set(_vision_llama "${tinystrata_intel_vision_llama_SOURCE_DIR}")
  endif()
  if(NOT EXISTS "${_vision_llama}/tools/mtmd/mtmd.h")
    message(FATAL_ERROR "Intel vision requires the pinned llama.cpp MTMD sources")
  endif()
  set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
  set(GGML_STATIC OFF CACHE BOOL "" FORCE)
  foreach(_part COMMON TOOLS TESTS EXAMPLES SERVER APP UI)
    set(LLAMA_BUILD_${_part} OFF CACHE BOOL "" FORCE)
  endforeach()
  set(LLAMA_BUILD_MTMD ON CACHE BOOL "" FORCE)
  set(LLAMA_OPENSSL OFF CACHE BOOL "" FORCE)
  set(LLAMA_CURL OFF CACHE BOOL "" FORCE)
  set(LLAMA_SUBPROCESS OFF CACHE BOOL "" FORCE)
  set(MTMD_VIDEO OFF CACHE BOOL "" FORCE)
  foreach(_backend CUDA HIP VULKAN METAL RPC OPENCL)
    set(GGML_${_backend} OFF CACHE BOOL "" FORCE)
  endforeach()
  set(GGML_SYCL ON CACHE BOOL "" FORCE)
  set(GGML_SYCL_TARGET INTEL CACHE STRING "" FORCE)
  set(GGML_SYCL_DNN OFF CACHE BOOL "" FORCE)
  set(GGML_SYCL_HOST_MEM_FALLBACK OFF CACHE BOOL "" FORCE)
  set(GGML_BACKEND_DL OFF CACHE BOOL "" FORCE)
  set(GGML_OPENMP OFF CACHE BOOL "" FORCE)
  set(GGML_NATIVE OFF CACHE BOOL "" FORCE)
  set(GGML_CPU_ALL_VARIANTS OFF CACHE BOOL "" FORCE)
  foreach(_feature AVX AVX2 FMA F16C BMI2)
    set(GGML_${_feature} ON CACHE BOOL "" FORCE)
  endforeach()
  foreach(_feature AVX_VNNI AVX512 AVX512_VBMI AVX512_VNNI AVX512_BF16 AMX_TILE AMX_INT8 AMX_BF16)
    set(GGML_${_feature} OFF CACHE BOOL "" FORCE)
  endforeach()
  set(MKL_LINK dynamic CACHE STRING "" FORCE)
  set(MKL_SYCL_LINK dynamic CACHE STRING "" FORCE)
  set(MKL_THREADING tbb_thread CACHE STRING "" FORCE)
  set(GGML_SYCL_MAX_PARALLEL_LINK_JOBS 2 CACHE STRING "Bound offline Intel vision link memory")
  # The pinned llama.cpp uses UTF-8 literals with its C++17 interface.
  set(CMAKE_CXX_STANDARD 17)
  add_subdirectory("${_vision_llama}" "${CMAKE_BINARY_DIR}/vision-llama" EXCLUDE_FROM_ALL)
  if(NOT TARGET ggml-sycl OR NOT TARGET mtmd)
    message(FATAL_ERROR "Intel vision requires the actual GGML SYCL and MTMD targets")
  endif()
  target_sources(ggml-sycl PRIVATE
    "${PROJECT_SOURCE_DIR}/src/vision/intel_device.cpp"
    "${PROJECT_SOURCE_DIR}/src/intel/device.cpp")
  target_include_directories(ggml-sycl PRIVATE "${PROJECT_SOURCE_DIR}/include"
    "${_vision_llama}/ggml/src/ggml-sycl" "${TINYSTRATA_LEVEL_ZERO_INCLUDE_DIR}")
  target_compile_definitions(ggml-sycl PRIVATE NOMINMAX)
  # Keep GGML's own Windows header contract: its GLA kernels use the u_int
  # typedef provided by the normal Windows headers. Only our device probes
  # inherit the language engine's lean Win32 include policy.
  set_property(SOURCE "${PROJECT_SOURCE_DIR}/src/vision/intel_device.cpp"
    "${PROJECT_SOURCE_DIR}/src/intel/device.cpp" TARGET_DIRECTORY ggml-sycl
    APPEND PROPERTY COMPILE_DEFINITIONS WIN32_LEAN_AND_MEAN)
  target_link_libraries(ggml-sycl PRIVATE "${TINYSTRATA_LEVEL_ZERO_LIBRARY}" dxgi psapi)
  add_executable(tinystrata-vision "${PROJECT_SOURCE_DIR}/src/vision/tinystrata_vision.cpp")
  target_compile_features(tinystrata-vision PRIVATE cxx_std_17)
  target_compile_options(tinystrata-vision PRIVATE -fsycl)
  target_link_options(tinystrata-vision PRIVATE -fsycl)
  target_compile_definitions(tinystrata-vision PRIVATE TINYSTRATA_VISION_SYCL=1 NOMINMAX WIN32_LEAN_AND_MEAN)
  target_link_libraries(tinystrata-vision PRIVATE mtmd llama strata_native_paths)
  set_target_properties(tinystrata-vision PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}")
  install(TARGETS tinystrata-vision RUNTIME DESTINATION bin)
  add_executable(intel_vision_protocol_test "${PROJECT_SOURCE_DIR}/tests/intel-vision-protocol.cpp")
  target_include_directories(intel_vision_protocol_test PRIVATE "${PROJECT_SOURCE_DIR}/include")
  target_compile_features(intel_vision_protocol_test PRIVATE cxx_std_17)
  add_test(NAME intel_vision_protocol COMMAND intel_vision_protocol_test)
endfunction()

tinystrata_add_intel_vision_encoder()
