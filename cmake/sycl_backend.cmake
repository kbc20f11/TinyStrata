# Intel is opt-in. These targets establish the native Windows foundation only;
# no model is advertised as supported until its engine and quality gates pass.
if(NOT WIN32)
  message(FATAL_ERROR "TinyStrata's experimental SYCL route currently targets native Windows")
endif()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "IntelLLVM" OR CMAKE_CXX_COMPILER_VERSION VERSION_LESS 2026.2)
  message(FATAL_ERROR "The initial Windows Intel route requires oneAPI DPC++/C++ 2026.2 or newer")
endif()
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "The Intel UMA route requires a 64-bit build")
endif()
include(CheckCXXCompilerFlag)
check_cxx_compiler_flag("-fsycl" TINYSTRATA_COMPILER_HAS_SYCL)
if(NOT TINYSTRATA_COMPILER_HAS_SYCL)
  message(FATAL_ERROR "SYCL requires Intel oneAPI icx (initialize the compiler and MSVC environments first)")
endif()
find_path(TINYSTRATA_LEVEL_ZERO_INCLUDE_DIR level_zero/ze_api.h REQUIRED)
find_library(TINYSTRATA_LEVEL_ZERO_LIBRARY NAMES ze_loader REQUIRED)
add_library(tinystrata_intel STATIC src/intel/device.cpp src/intel/qwen_ops.cpp src/intel/attention.cpp src/intel/kv_q8.cpp src/intel/xmx.cpp src/intel/decode_dp4a.cpp src/intel/weight_store.cpp)
target_include_directories(tinystrata_intel PUBLIC include PRIVATE "${TINYSTRATA_LEVEL_ZERO_INCLUDE_DIR}")
target_include_directories(tinystrata_intel PRIVATE third_party/ggml)
target_compile_options(tinystrata_intel PUBLIC -fsycl)
target_link_options(tinystrata_intel PUBLIC -fsycl)
target_compile_definitions(tinystrata_intel PUBLIC NOMINMAX WIN32_LEAN_AND_MEAN)
# Generic SPIR-V remains the default. Exact PTL-H AOT has been checked with
# oneAPI/OCLOC 2026.2 on the B390; other targets need their own validation.
set(TINYSTRATA_INTEL_AOT_TARGET "" CACHE STRING "Optional Intel GPU AOT target (empty for generic SPIR-V)")
set_property(CACHE TINYSTRATA_INTEL_AOT_TARGET PROPERTY STRINGS "" intel_gpu_ptl_h)
if(NOT TINYSTRATA_INTEL_AOT_TARGET STREQUAL "" AND NOT TINYSTRATA_INTEL_AOT_TARGET STREQUAL "intel_gpu_ptl_h")
  message(FATAL_ERROR "Only the explicit Intel AOT target intel_gpu_ptl_h is currently enabled")
endif()
if(TINYSTRATA_INTEL_AOT_TARGET)
  # Keep OCLOC on PATH for both configuration and the later icx native link.
  # build-intel.ps1 prepares this process-local environment.
  find_program(TINYSTRATA_INTEL_OCLOC_EXECUTABLE NAMES ocloc.exe ocloc REQUIRED)
  if(NOT EXISTS "${TINYSTRATA_INTEL_OCLOC_EXECUTABLE}" OR IS_DIRECTORY "${TINYSTRATA_INTEL_OCLOC_EXECUTABLE}")
    message(FATAL_ERROR "Intel AOT requires the OCLOC executable in the build environment")
  endif()
  execute_process(COMMAND "${TINYSTRATA_INTEL_OCLOC_EXECUTABLE}" compile --help
    RESULT_VARIABLE TINYSTRATA_OCLOC_HELP_RESULT OUTPUT_VARIABLE TINYSTRATA_OCLOC_HELP ERROR_VARIABLE TINYSTRATA_OCLOC_HELP_ERROR)
  if(NOT TINYSTRATA_OCLOC_HELP_RESULT EQUAL 0 OR NOT TINYSTRATA_OCLOC_HELP MATCHES "ptl[-_]h")
    message(FATAL_ERROR "Installed OCLOC does not advertise the required PTL-H target: ${TINYSTRATA_OCLOC_HELP_ERROR}")
  endif()
  target_compile_options(tinystrata_intel PUBLIC "-fsycl-targets=${TINYSTRATA_INTEL_AOT_TARGET}")
  target_link_options(tinystrata_intel PUBLIC "-fsycl-targets=${TINYSTRATA_INTEL_AOT_TARGET}")
  message(STATUS "Intel GPU AOT target: ${TINYSTRATA_INTEL_AOT_TARGET}; OCLOC: ${TINYSTRATA_INTEL_OCLOC_EXECUTABLE}")
endif()
target_compile_definitions(tinystrata_intel PUBLIC "TINYSTRATA_INTEL_AOT_TARGET=\"${TINYSTRATA_INTEL_AOT_TARGET}\"")
target_link_libraries(tinystrata_intel PRIVATE "${TINYSTRATA_LEVEL_ZERO_LIBRARY}" dxgi psapi)
option(TINYSTRATA_INTEL_NPU "Build the optional runtime-weight Intel NPU prefill candidate" OFF)
option(TINYSTRATA_INTEL_MKL "Build the bounded-scratch oneMKL prefill candidate" OFF)
option(TINYSTRATA_INTEL_INT8_XMX "Build the optional INT8 XMX verification candidate" OFF)
if(TINYSTRATA_INTEL_INT8_XMX)
  target_sources(tinystrata_intel PRIVATE src/intel/q8_xmx.cpp)
  target_compile_definitions(tinystrata_intel PUBLIC TINYSTRATA_INTEL_INT8_XMX=1)
endif()
if(TINYSTRATA_INTEL_MKL)
  find_path(TINYSTRATA_MKL_INCLUDE oneapi/mkl/blas.hpp HINTS "$ENV{MKLROOT}/include" REQUIRED)
  find_library(TINYSTRATA_MKL_BLAS mkl_sycl_blas_dll HINTS "$ENV{MKLROOT}/lib" REQUIRED)
  target_sources(tinystrata_intel PRIVATE src/intel/prefill_gemm.cpp)
  target_include_directories(tinystrata_intel PRIVATE "${TINYSTRATA_MKL_INCLUDE}")
  target_compile_definitions(tinystrata_intel PUBLIC TINYSTRATA_INTEL_MKL=1)
  target_link_libraries(tinystrata_intel PUBLIC "${TINYSTRATA_MKL_BLAS}")
endif()
if(TINYSTRATA_INTEL_NPU)
  find_package(OpenVINO REQUIRED COMPONENTS Runtime)
  target_sources(tinystrata_intel PRIVATE src/intel/npu.cpp)
  target_compile_definitions(tinystrata_intel PUBLIC TINYSTRATA_INTEL_NPU=1)
  target_link_libraries(tinystrata_intel PUBLIC openvino::runtime)
  add_executable(intel_npu_projection_test tests/intel-npu-projection.cpp)
  target_link_libraries(intel_npu_projection_test PRIVATE tinystrata_intel strata_native_paths)
endif()
add_executable(tinystrata-intel-probe src/intel/probe.cpp)
target_link_libraries(tinystrata-intel-probe PRIVATE tinystrata_intel)
add_executable(intel_memory_policy_test tests/intel-memory-policy.cpp)
target_include_directories(intel_memory_policy_test PRIVATE include)
enable_testing()
add_test(NAME intel_memory_policy COMMAND intel_memory_policy_test)
add_executable(intel_speculative_distribution_test tests/intel-speculative-distribution.cpp)
target_include_directories(intel_speculative_distribution_test PRIVATE include)
add_test(NAME intel_speculative_distribution COMMAND intel_speculative_distribution_test)
add_executable(intel_draft_vocabulary_test tests/intel-draft-vocabulary.cpp)

target_include_directories(intel_draft_vocabulary_test PRIVATE include)
add_test(NAME intel_draft_vocabulary COMMAND intel_draft_vocabulary_test)
add_executable(intel_qwen_ops_test tests/intel-qwen-ops.cpp)
target_link_libraries(intel_qwen_ops_test PRIVATE tinystrata_intel strata_native_paths)
add_executable(tinystrata-intel-weights src/intel/weights_probe.cpp)
target_link_libraries(tinystrata-intel-weights PRIVATE tinystrata_intel strata_native_paths)
add_executable(tinystrata-intel src/intel/qwen_engine.cpp)
target_link_libraries(tinystrata-intel PRIVATE tinystrata_intel strata_native_paths Threads::Threads)
install(TARGETS tinystrata-intel tinystrata-intel-probe tinystrata-intel-weights RUNTIME DESTINATION bin)
install(FILES LICENSE NOTICE DESTINATION share/licenses/TinyStrata)
install(FILES third_party/ggml/LICENSE DESTINATION share/licenses/TinyStrata/ggml)
install(FILES third_party/licenses/gufo.txt DESTINATION share/licenses/TinyStrata/gufo RENAME LICENSE)
